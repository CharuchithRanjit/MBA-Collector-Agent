<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Chief — {{ header_date }}</title>
<style>
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    max-width: 600px;
    margin: 0 auto;
    padding: 1rem;
    line-height: 1.5;
    color: #1a1a1a;
  }
  h1 { font-size: 1.4rem; margin-bottom: 0.5rem; }
  h2 {
    font-size: 1rem;
    margin-top: 1.5rem;
    border-bottom: 1px solid #ddd;
    padding-bottom: 0.25rem;
  }
  .focus {
    font-size: 1.1rem;
    padding: 0.75rem;
    background: #f5f5f5;
    border-radius: 8px;
  }
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  td, th { text-align: left; padding: 0.25rem 0.5rem 0.25rem 0; }
  ul { padding-left: 1.2rem; }
  .stale { color: #b45309; }
  footer { font-size: 0.75rem; color: #888; margin-top: 2rem; }
</style>
</head>
<body>
<h1>Good morning — {{ header_date }}</h1>

<h2>Focus</h2>
<div class="focus">{{ focus }}</div>

<h2>Deadlines · next 7 days</h2>
{% if deadlines %}
<table>
<tr><th>When</th><th>Company</th><th>Role</th><th>Status</th></tr>
{% for d in deadlines %}
<tr><td>{{ d.when }}</td><td>{{ d.company }}</td><td>{{ d.role }}</td><td>{{ d.status_label }}</td></tr>
{% endfor %}
</table>
{% if deadlines_overflow %}
<p>+{{ deadlines_overflow }} more</p>
{% endif %}
{% else %}
<p>None.</p>
{% endif %}

<h2>Next actions · due</h2>
{% if next_actions %}
<ul>
{% for a in next_actions %}
<li><strong>{{ a.when }}</strong> — {{ a.company }}: {{ a.text }}</li>
{% endfor %}
</ul>
{% else %}
<p>Nothing due today.</p>
{% endif %}

<h2>Pipeline</h2>
<p>{{ pipeline.tracked }} tracked · {{ pipeline.applied }} applied · {{ pipeline.in_process }} in process · {{ pipeline.offer_stage }} offer-stage · {{ pipeline.not_started }} not started</p>
{% for name in pipeline.stale %}
<p class="stale">⚠ Stale: <strong>{{ name }}</strong></p>
{% endfor %}

<h2>AI news · {{ news_total }} items</h2>
{% if news %}
<ul>
{% for n in news %}
<li>[{{ n.category }}] {{ n.headline }} — <em>{{ n.source }}, {{ n.read_time }}</em></li>
{% endfor %}
</ul>
{% if news_overflow %}
<p>+{{ news_overflow }} more</p>
{% endif %}
{% else %}
<p>None.</p>
{% endif %}

<footer>Generated {{ generated_label }} · {{ items_scanned }} items scanned, {{ items_kept }} kept · {{ cost_label }} · {{ prompt_versions_label }}</footer>
</body>
</html>
