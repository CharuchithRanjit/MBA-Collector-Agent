# Copy to .env and fill in. .env is gitignored — never commit it.

# Required for `chief brief --send`. ntfy.sh is a public, unauthenticated
# server — anyone who knows this topic name can read pushes sent to it.
# Pick something unguessable, e.g. a uuid.
NTFY_TOPIC=pick-something-unguessable-like-a-uuid
